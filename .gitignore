# Dépôt placé dans ~/Projects/devmobile : on ne publie QUE les trois projets
# (le SDK Flutter, les projets d'essai et les sauvegardes restent en local)
/*
!/.gitignore
!/README.md
!/LICENSE
!/docs/
!/movies/
!/movie_data/
!/movie_plugin/

